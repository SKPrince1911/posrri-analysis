# ---- Real participant / field data: NEVER commit ----------------------------
# Ignore everything inside data/raw/ but keep the directory itself, so a fresh
# clone has somewhere obvious to put real data. (Ignoring the directory rather
# than its contents would stop git descending into it, and the .gitkeep
# exception below would never be reached.)
data/raw/*
!data/raw/.gitkeep

# Generated outputs (outputs/) are derived solely from the committed synthetic
# data and ARE tracked, so reviewers can see the figures and tables without
# running the pipeline. Re-running the notebook or tests regenerates them
# byte-for-byte from the fixed seed.

# ---- Notebooks --------------------------------------------------------------
.ipynb_checkpoints/
**/.ipynb_checkpoints/
*-checkpoint.ipynb

# ---- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# ---- Tooling / OS -----------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.DS_Store
Thumbs.db
*.swp

# ---- Google Colab / Drive artefacts ----------------------------------------
drive/
sample_data/
